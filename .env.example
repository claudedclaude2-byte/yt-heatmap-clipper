# ── Copy this file to .env and fill in your keys ────────────────────────────

# YouTube Data API v3 key (for trend finding + Shorts upload)
YOUTUBE_API_KEY=

# TikTok Content Posting API v2 access token
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API credentials
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Claude (for AI caption generation — free $5 credit on signup)
ANTHROPIC_API_KEY=

# Your affiliate / product link — baked into every clip's CTA
AFFILIATE_LINK=https://yourlink.com
AFFILIATE_LABEL=💰 Link in bio

# Path to YouTube OAuth2 client secrets JSON (for Shorts upload)
YOUTUBE_CLIENT_SECRETS=client_secrets.json
