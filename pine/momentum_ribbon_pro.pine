// ============================================================
// Momentum Ribbon Pro
// Upgraded from the tradesdontlie/tradingview-mcp demo video
// Adds: ADX gate, volume filter, session filter, ATR stops,
//       entry signals, EMA plots, alerts
// ============================================================

//@version=5
indicator("Momentum Ribbon Pro", overlay=true, max_bars_back=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
// Ribbon
len1    = input.int(8,   "Fast EMA",            minval=2,  group="Ribbon Lengths")
len2    = input.int(13,  "Mid EMA",             minval=2,  group="Ribbon Lengths")
len3    = input.int(21,  "Slow EMA",            minval=2,  group="Ribbon Lengths")
len4    = input.int(34,  "Anchor EMA",          minval=2,  group="Ribbon Lengths")

// ADX filter
adxLen  = input.int(14,  "ADX Period",          minval=2,  group="Filters")
adxMin  = input.int(22,  "Min ADX (trend gate)",minval=1,  group="Filters",
          tooltip="Signal only fires when ADX is above this. 20-25 = trending, <20 = ranging.")

// Volume filter
volLen  = input.int(20,  "Volume SMA Period",   minval=1,  group="Filters")
volMult = input.float(1.4,"Volume Multiplier",  minval=0.1,step=0.1, group="Filters",
          tooltip="Volume on signal bar must be > this × avg volume.")

// Session filter
useSess = input.bool(true, "US Session filter (09:30–16:00 EST)", group="Filters",
          tooltip="Ignores signals outside RTH. Disable for crypto/24h markets.")

// ATR stops
atrLen  = input.int(14,  "ATR Period",          minval=1,  group="Risk")
atrMult = input.float(1.5,"ATR Stop Multiplier",minval=0.1,step=0.1, group="Risk",
          tooltip="Stop = entry ± (ATR × multiplier). Shown as orange dashes.")
showStop= input.bool(true, "Show ATR stop lines",               group="Risk")

// Display
showBg  = input.bool(true, "Background colour on signal",       group="Display")
showEMA = input.bool(true, "Plot EMA lines",                    group="Display")

// ─── EMAs ────────────────────────────────────────────────────────────────────
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)
ema4 = ta.ema(close, len4)

// ─── TREND STATE (strict full-stack) ─────────────────────────────────────────
bullStack = ema1 > ema2 and ema2 > ema3 and ema3 > ema4
bearStack = ema1 < ema2 and ema2 < ema3 and ema3 < ema4
neutral   = not bullStack and not bearStack

// ─── RIBBON FLIP (first bar of new trend — entry signal) ─────────────────────
bullFlip  = bullStack and not bullStack[1]
bearFlip  = bearStack and not bearStack[1]

// ─── ADX FILTER ──────────────────────────────────────────────────────────────
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trending  = adxVal >= adxMin

// ─── VOLUME FILTER ───────────────────────────────────────────────────────────
volSma    = ta.sma(volume, volLen)
volOk     = volume >= volSma * volMult

// ─── SESSION FILTER ──────────────────────────────────────────────────────────
inSession = not useSess or
            (hour(time, "America/New_York") * 60 + minute(time, "America/New_York") >= 9 * 60 + 30 and
             hour(time, "America/New_York") * 60 + minute(time, "America/New_York") <  16 * 60)

// ─── CLEAN ENTRY SIGNALS (all gates must pass) ───────────────────────────────
longSignal  = bullFlip and trending and volOk and inSession
shortSignal = bearFlip and trending and volOk and inSession

// Trend-continuation state (for background colour during held trend)
longTrend  = bullStack and trending and inSession
shortTrend = bearStack and trending and inSession

// ─── ATR ─────────────────────────────────────────────────────────────────────
atrVal    = ta.atr(atrLen)

// Track entry price for stop reference
var float entryPx = na
var int   tradeDir = 0  // 1=long, -1=short

if longSignal
    entryPx := close
    tradeDir := 1
if shortSignal
    entryPx := close
    tradeDir := -1
if neutral
    entryPx := na
    tradeDir := 0

longStopPx  = tradeDir ==  1 ? entryPx - atrMult * atrVal : na
shortStopPx = tradeDir == -1 ? entryPx + atrMult * atrVal : na

// ─── COLOURS ─────────────────────────────────────────────────────────────────
C_BULL  = color.new(#26a69a, 0)   // teal
C_BEAR  = color.new(#ef5350, 0)   // red
C_NEUT  = color.new(#787b86, 0)   // grey

ribbonCol = bullStack ? C_BULL : bearStack ? C_BEAR : C_NEUT

// ─── PLOT EMAs ───────────────────────────────────────────────────────────────
plot(showEMA ? ema1 : na, "EMA 8",  color=color.new(ribbonCol, 30), linewidth=1)
plot(showEMA ? ema2 : na, "EMA 13", color=color.new(ribbonCol, 40), linewidth=1)
plot(showEMA ? ema3 : na, "EMA 21", color=color.new(ribbonCol, 20), linewidth=2)
plot(showEMA ? ema4 : na, "EMA 34", color=color.new(ribbonCol, 10), linewidth=2)

// Fill between EMA1 and EMA4 (the ribbon band)
ema1plot = plot(showEMA ? ema1 : na, display=display.none)
ema4plot = plot(showEMA ? ema4 : na, display=display.none)
fill(ema1plot, ema4plot,
     color = bullStack ? color.new(#26a69a, 88) :
             bearStack ? color.new(#ef5350, 88) :
             color.new(#787b86, 95))

// ─── BACKGROUND ──────────────────────────────────────────────────────────────
bgcolor(showBg and longTrend  ? color.new(#26a69a, 93) :
        showBg and shortTrend ? color.new(#ef5350, 93) : na,
        title="Trend background")

// ─── ENTRY SIGNALS ───────────────────────────────────────────────────────────
plotshape(longSignal,  "Long Entry",
          shape.triangleup,   location.belowbar, C_BULL, size=size.normal)
plotshape(shortSignal, "Short Entry",
          shape.triangledown, location.abovebar, C_BEAR, size=size.normal)

// ─── ATR STOP LINES ──────────────────────────────────────────────────────────
plot(showStop ? longStopPx  : na, "Long Stop",
     color=color.new(#ff9800, 40), linewidth=1, style=plot.style_linebr)
plot(showStop ? shortStopPx : na, "Short Stop",
     color=color.new(#ff9800, 40), linewidth=1, style=plot.style_linebr)

// ─── INFO TABLE ──────────────────────────────────────────────────────────────
var table infoTbl = table.new(position.top_right, 2, 5,
                              bgcolor=#1e222d, border_color=#363a45, border_width=1)

if barstate.islast
    trendStr   = bullStack ? "▲ BULLISH" : bearStack ? "▼ BEARISH" : "— NEUTRAL"
    trendCol   = bullStack ? C_BULL      : bearStack ? C_BEAR      : C_NEUT
    adxStr     = str.tostring(math.round(adxVal, 1))
    adxCol     = adxVal >= adxMin ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    volStr     = str.tostring(math.round(volume / volSma * 100, 0)) + "% of avg"
    volCol     = volOk ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    sessStr    = inSession ? "✓ In session" : "✗ Off hours"
    sessCol    = inSession ? color.new(#26a69a, 0) : color.new(#787b86, 0)

    table.cell(infoTbl, 0, 0, "TREND",    text_color=#9598a1, text_size=size.tiny)
    table.cell(infoTbl, 1, 0, trendStr,   text_color=trendCol, text_size=size.tiny)
    table.cell(infoTbl, 0, 1, "ADX",      text_color=#9598a1, text_size=size.tiny)
    table.cell(infoTbl, 1, 1, adxStr,     text_color=adxCol,  text_size=size.tiny)
    table.cell(infoTbl, 0, 2, "VOLUME",   text_color=#9598a1, text_size=size.tiny)
    table.cell(infoTbl, 1, 2, volStr,     text_color=volCol,  text_size=size.tiny)
    table.cell(infoTbl, 0, 3, "SESSION",  text_color=#9598a1, text_size=size.tiny)
    table.cell(infoTbl, 1, 3, sessStr,    text_color=sessCol, text_size=size.tiny)
    table.cell(infoTbl, 0, 4, "ATR",      text_color=#9598a1, text_size=size.tiny)
    table.cell(infoTbl, 1, 4, str.tostring(math.round(atrVal, 2)),
               text_color=#9598a1, text_size=size.tiny)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(longSignal,
               "LONG — Ribbon Pro",
               "LONG {{ticker}} | TF: {{interval}} | Price: {{close}} | ADX: " +
               str.tostring(math.round(adxVal, 1)))

alertcondition(shortSignal,
               "SHORT — Ribbon Pro",
               "SHORT {{ticker}} | TF: {{interval}} | Price: {{close}} | ADX: " +
               str.tostring(math.round(adxVal, 1)))

alertcondition(bullFlip and not trending,
               "Ribbon flipped BULL (ADX too low — watch only)",
               "WATCH {{ticker}} — ribbon bull but ADX=" + str.tostring(math.round(adxVal,1)))

alertcondition(bearFlip and not trending,
               "Ribbon flipped BEAR (ADX too low — watch only)",
               "WATCH {{ticker}} — ribbon bear but ADX=" + str.tostring(math.round(adxVal,1)))
